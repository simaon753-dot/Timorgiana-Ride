{
  "expo": {
    "name": "TimorgianaRide",
    "slug": "timorgianaride",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "timorgianaride",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E5C54"
    },
    "ios": {
      "bundleIdentifier": "tl.timorgiana.ride",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "A TimorgianaRide usa a sua localização para marcar o ponto de recolha e mostrar ao motorista onde o ir buscar.",
        "NSPhotoLibraryUsageDescription": "A TimorgianaRide precisa de aceder às suas fotografias para enviar a carta de condução e os documentos do veículo, exigidos para conduzir.",
        "NSCameraUsageDescription": "A TimorgianaRide usa a câmara para fotografar a carta de condução, os documentos do veículo e a fotografia diária que confirma quem está ao volante."
      }
    },
    "android": {
      "package": "tl.timorgiana.ride",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E5C54"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d23e9f97-dffd-40bd-98d6-74f93437289c"
      }
    },
    "owner": "simaon753",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d23e9f97-dffd-40bd-98d6-74f93437289c",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    }
  }
}
