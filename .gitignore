# --- Dependências (regeneram-se com `npm install`) ---
node_modules/

# --- SEGREDOS: nunca versionar ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Base de dados (contém dados de utilizadores) ---
data/
*.db
*.db-shm
*.db-wal
*.db-journal

# --- Builds e caches ---
dist/
web-build/
.expo/
.metro-health-check*
*.tsbuildinfo

# --- Registos ---
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# --- Sistema ---
.DS_Store
Thumbs.db

# --- Pastas nativas geradas ---
/mobile/ios
/mobile/android

# Cópias da base de dados: contêm documentos de identificação em base64.
# Nunca entram no repositório.
copias/

# As cópias de segurança da base de dados. NUNCA no repositório: levam os
# documentos de identificação dos motoristas e os telemóveis dos passageiros,
# e este repositório é público.
copia-*.sql

# Capturas em bruto do telemóvel. O repositório é público e o histórico do
# git é para sempre: aqui entram fotografias que talvez não sejam usadas, com
# nomes, números e matrículas verdadeiros. Só vai para o repositório o que for
# escolhido, já preparado, em loja/capturas/.
loja/capturas-originais/
