# Copiar este ficheiro para .env e ajustar os valores
PORT=4000

# Segredo usado para assinar os tokens JWT.
# Em produção, gerar um valor longo e aleatório (ex.: openssl rand -hex 32)
JWT_SECRET=trocar-este-segredo-em-producao

# Caminho do ficheiro da base de dados SQLite (relativo à pasta backend/)
DB_FILE=./data/timorgianaride.db
