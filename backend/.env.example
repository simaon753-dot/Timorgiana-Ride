# Copiar para .env e preencher

# Porta (o alojamento normalmente define isto sozinho)
PORT=4000

# Segredo dos tokens de sessão.
# Gerar com: openssl rand -hex 32
JWT_SECRET=trocar-este-segredo-em-producao

# Ligação PostgreSQL — copiada do painel do Neon
# Formato: postgresql://utilizador:senha@servidor/base?sslmode=require
DATABASE_URL=
